{
  "name": "MAKINA",
  "packageId": "com.makina.gestao",
  "version": "1.2.0",
  "versionCode": 12,
  "entry": "dist/index.html",
  "orientation": "auto",
  "statusBar": true,
  "permissions": [
    "INTERNET",
    "ACCESS_NETWORK_STATE",
    "ACCESS_WIFI_STATE",
    "CAMERA",
    "READ_EXTERNAL_STORAGE",
    "WRITE_EXTERNAL_STORAGE",
    "READ_MEDIA_IMAGES",
    "POST_NOTIFICATIONS",
    "VIBRATE",
    "RECEIVE_BOOT_COMPLETED",
    "WAKE_LOCK"
  ],
  "icon": "./public/icons/icon-512.png",
  "network": {
    "cleartext": false
  },
  "webview": {
    "backButton": "history",
    "clearCacheOnStart": false
  },
  "splashScreen": {
    "backgroundColor": "#0f172a"
  }
}
